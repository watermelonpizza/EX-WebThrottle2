{
    "name": "ex-webthrottle2",
    "version": "0.0.0",
    "description": "Next-generation DCC-EX browser throttle (WebThrottle-EX successor)",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "test:unit": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "vuetify": "^4.2.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.6.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-istanbul": "^5.0.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.8",
        "sass": "^1.105.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.0",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    }
}