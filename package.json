{
  "name": "ex-webthrottle2",
  "version": "0.0.0",
  "description": "Next-generation DCC-EX browser throttle (WebThrottle-EX successor)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:emulator": "make -C emulator && vitest run --config emulator/vitest.config.ts",
    "test:e2e": "playwright test",
    "emulator": "make -C emulator && node emulator/bridge.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^6.0.0-beta.6",
    "@types/node": "^26.6.2",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "ws": "^8.21.3"
  }
}
